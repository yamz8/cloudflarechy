#!/usr/bin/env bash
# Data bridge between the Omarchy shell and the Cloudflare API.
#
# Every subcommand writes exactly one JSON object to stdout and leaves
# diagnostics on stderr, so a QML Process can parse stdout without filtering.
# Failures are data too: they come back as {"error": "...", "hint": "..."} with
# exit 0, because a panel that can render the reason is more useful than a
# non-zero exit the shell would have to guess at.
#
#   cloudflarechy status
#   cloudflarechy setup            what credentials this machine could use
#   cloudflarechy save-token       reads the token on stdin, checks it, saves it
#   cloudflarechy forget-token
#   cloudflarechy zones
#   cloudflarechy overview <zone-id>
#   cloudflarechy tunnels <account-id>
#   cloudflarechy workers <account-id>
#   cloudflarechy worker  <account-id> <script>
#   cloudflarechy devmode <zone-id> on|off
#   cloudflarechy attack  <zone-id> on|off
#   cloudflarechy purge   <zone-id>
#
# A leading --fresh bypasses the read cache, which is what the panel's manual
# refresh uses.
set -uo pipefail

# Overridable so the request paths can be exercised against a local stand-in
# without a real account; nothing but tests should ever set it.
API="${CLOUDFLARECHY_API_BASE:-https://api.cloudflare.com/client/v4}"

# Quickshell does not inherit an interactive shell's PATH, so tools installed
# outside /usr/bin are invisible unless we look for them.
resolve() {
  local name="$1" p
  p=$(command -v "$name" 2>/dev/null) && [[ -n $p ]] && { echo "$p"; return 0; }
  for p in /usr/bin/"$name" /usr/local/bin/"$name" "$HOME/.local/bin/$name" \
           "$HOME/.local/share/mise/shims/$name"; do
    [[ -x $p ]] && { echo "$p"; return 0; }
  done
  return 1
}

CURL=$(resolve curl) || { printf '{"error":"curl not found"}\n'; exit 0; }
JQ=$(resolve jq)     || { printf '{"error":"jq not found"}\n'; exit 0; }

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cloudflarechy"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cloudflarechy"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cloudflarechy"
TOKEN_FILE="${CLOUDFLARECHY_TOKEN_FILE:-$CONFIG_DIR/token}"

# Hints are read by a person, so paths in them are written the way that person
# would type them.
pretty_path() {
  local path="$1"
  [[ $path == "$HOME"/* ]] && { printf '~%s' "${path#"$HOME"}"; return; }
  printf '%s' "$path"
}

NO_CACHE="${CLOUDFLARECHY_NO_CACHE:-0}"
if [[ ${1:-} == --fresh ]]; then NO_CACHE=1; shift; fi

die() {
  "$JQ" -n --arg e "$1" --arg h "${2:-}" \
    '{error: $e} + (if $h == "" then {} else {hint: $h} end)'
  exit 0
}

# ------------------------------------------------------------------ the token

# An API token, not the legacy global key: this plugin only ever needs a
# handful of scopes, and a token can be minted with exactly those.
#
# Failing that, wrangler's OAuth credential works for everything this plugin
# reads. It cannot work for anything it writes: the whole catalogue wrangler
# can request (`wrangler login --scopes-list`) contains exactly one zone
# scope, `zone:read`. There is no zone-settings-write and no cache-purge
# scope to ask for, so read-only is the ceiling, not a precaution.
TOKEN=""
TOKEN_SOURCE=""
TOKEN_KIND=""      # api | oauth
TOKEN_EXPIRES=""   # ISO 8601, oauth only
TOKEN_NOTE=""      # why a source that exists was passed over

# Wrangler keeps its credential under XDG config; the pre-XDG location still
# turns up on machines that have been upgraded rather than reinstalled.
WRANGLER_CONFIGS=(
  "${XDG_CONFIG_HOME:-$HOME/.config}/.wrangler/config/default.toml"
  "$HOME/.wrangler/config/default.toml"
)

# Enough TOML for `key = "value"`, which is all wrangler writes here.
toml_value() {
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" 2>/dev/null | head -1
}

# Read wrangler's token, but only while it is still valid. Wrangler refreshes
# on use, and it owns that file — rotating its tokens from a bar widget would
# race the tool itself and could cost the user their `wrangler` login. So an
# expired session is reported, not repaired.
load_wrangler_token() {
  local file token expires expiry_epoch now
  for file in "${WRANGLER_CONFIGS[@]}"; do
    [[ -r $file ]] || continue
    token=$(toml_value "$file" oauth_token)
    [[ -n $token ]] || continue
    expires=$(toml_value "$file" expiration_time)
    if [[ -n $expires ]]; then
      expiry_epoch=$(date -u -d "$expires" +%s 2>/dev/null) || expiry_epoch=""
      now=$(date -u +%s)
      if [[ -n $expiry_epoch ]] && (( expiry_epoch <= now )); then
        TOKEN_NOTE="wrangler session expired"
        continue
      fi
    fi
    TOKEN="$token"
    TOKEN_SOURCE="wrangler"
    TOKEN_KIND="oauth"
    TOKEN_EXPIRES="$expires"
    return 0
  done
  return 1
}

load_token() {
  TOKEN_KIND="api"
  if [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then
    TOKEN="$CLOUDFLARE_API_TOKEN"; TOKEN_SOURCE="CLOUDFLARE_API_TOKEN"; return 0
  fi
  if [[ -n ${CF_API_TOKEN:-} ]]; then
    TOKEN="$CF_API_TOKEN"; TOKEN_SOURCE="CF_API_TOKEN"; return 0
  fi
  if [[ -r $TOKEN_FILE ]]; then
    # Trim whitespace and any trailing newline: a token saved with a plain
    # editor picks one up, and the API rejects it with an unhelpful 400.
    TOKEN=$(tr -d '\r\n[:space:]' < "$TOKEN_FILE")
    if [[ -n $TOKEN ]]; then TOKEN_SOURCE=$(pretty_path "$TOKEN_FILE"); return 0; fi
  fi
  local secret
  if secret=$(resolve secret-tool); then
    TOKEN=$("$secret" lookup service cloudflarechy 2>/dev/null | tr -d '\r\n')
    if [[ -n $TOKEN ]]; then TOKEN_SOURCE="secret-tool"; return 0; fi
  fi
  # Last, because an explicit token is a decision and this one is a leftover
  # from some other afternoon's work.
  load_wrangler_token && return 0
  TOKEN_KIND=""
  return 1
}

readonly_credential() { [[ $TOKEN_KIND == oauth ]]; }

# Writes stop here rather than at Cloudflare. A 9109 passed through from the
# API tells the user nothing they can act on; this tells them exactly which
# credential they are holding and what it would take to do the thing.
require_write() {
  readonly_credential || return 0
  die "wrangler's credential is read-only" \
      "Wrangler can only be granted zone:read — no zone-settings or cache-purge scope exists to request. Add an API token to use this."
}

require_token() {
  load_token && return 0
  if [[ $TOKEN_NOTE == "wrangler session expired" ]]; then
    die "wrangler session expired" \
        "Run any wrangler command to refresh it, or save an API token to $(pretty_path "$TOKEN_FILE")."
  fi
  die "no Cloudflare API token" \
      "Create one at dash.cloudflare.com/profile/api-tokens and save it to $(pretty_path "$TOKEN_FILE") (chmod 600), or export CLOUDFLARE_API_TOKEN. A `wrangler login` also works, read-only."
}

# ------------------------------------------------------------------- requests

api() {
  local method="$1" path="$2" body="${3:-}"
  local -a args=(-sS --max-time 20 -X "$method"
                 -H "Authorization: Bearer $TOKEN"
                 -H "Content-Type: application/json")
  [[ -n $body ]] && args+=(--data-binary "$body")
  "$CURL" "${args[@]}" "$API$path" 2>/dev/null
}

# Cloudflare answers 4xx with a JSON envelope that names the missing scope, so
# the body is worth more than the status line — hence no curl -f anywhere here.
api_error() {
  local raw="$1"
  [[ -z $raw ]] && { echo "no response from api.cloudflare.com"; return 0; }
  "$JQ" -r '
    if type != "object" then "unreadable response from api.cloudflare.com"
    elif (.success == true) then ""
    else ((.errors // []) | map(.message // empty) | join("; "))
         | if . == "" then "request failed" else . end
    end' <<<"$raw" 2>/dev/null || echo "unreadable response from api.cloudflare.com"
}

# GraphQL is a separate endpoint with a separate error shape: HTTP 200 with a
# top-level `errors` array and `data: null`.
gql() {
  local query="$1" variables="$2" body
  body=$("$JQ" -n --arg q "$query" --argjson v "$variables" '{query: $q, variables: $v}')
  "$CURL" -sS --max-time 25 -X POST \
    -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \
    --data-binary "$body" "$API/graphql" 2>/dev/null
}

gql_error() {
  local raw="$1"
  [[ -z $raw ]] && { echo "no response from api.cloudflare.com"; return 0; }
  "$JQ" -r '
    if type != "object" then "unreadable response from api.cloudflare.com"
    elif ((.errors // []) | length) > 0
      then ((.errors // []) | map(.message // empty) | join("; "))
    elif (.data == null) then "analytics returned no data"
    else "" end' <<<"$raw" 2>/dev/null || echo "unreadable response from api.cloudflare.com"
}

# ---------------------------------------------------------------- read cache

# Analytics is the expensive call and the panel polls it, so answers are held
# briefly on disk. Writes (purge, dev mode, under attack) drop the cache for
# the zone they touched rather than waiting it out.
cache_key() { printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '_'; }

cache_read() {
  local f="$CACHE_DIR/$(cache_key "$1")" ttl="$2" age
  [[ $NO_CACHE == 1 ]] && return 1
  [[ -r $f ]] || return 1
  age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
  (( age >= 0 && age <= ttl )) || return 1
  cat "$f"
}

cache_write() {
  local f="$CACHE_DIR/$(cache_key "$1")"
  mkdir -p "$CACHE_DIR" 2>/dev/null || { cat >/dev/null; return 0; }
  cat > "$f"
}

cache_drop() { rm -f "$CACHE_DIR/$(cache_key "$1")" 2>/dev/null; return 0; }

# Reads take this path: the payload is printed for the shell either way, and
# cached only when it parsed as JSON — a truncated answer is worth nothing on
# the next open.
cache_and_print() {
  local key="$1" payload
  payload=$(cat)
  printf '%s\n' "$payload"
  "$JQ" -e . >/dev/null 2>&1 <<<"$payload" && cache_write "$key" <<<"$payload"
  return 0
}

# ------------------------------------------------------------------ commands

# Token health without needing any scope: /user/tokens/verify works for every
# token, so a panel can tell "no token" from "token expired" from "token fine,
# but it cannot read zones".
cmd_status() {
  if ! load_token; then
    if [[ $TOKEN_NOTE == "wrangler session expired" ]]; then
      "$JQ" -n --arg file "$(pretty_path "$TOKEN_FILE")" '{
        token: false, token_source: "wrangler", token_kind: "oauth",
        expires_at: "", read_only: true, valid: false,
        message: "wrangler session expired",
        hint: ("Run any wrangler command to refresh it, or save an API token to " + $file + ".")
      }'
      return
    fi
    "$JQ" -n --arg file "$(pretty_path "$TOKEN_FILE")" '{
      token: false, token_source: "", token_kind: "",
      expires_at: "", read_only: false, valid: false,
      message: "no API token",
      hint: ("Save a Cloudflare API token to " + $file + " (chmod 600), export CLOUDFLARE_API_TOKEN, or run `wrangler login` for a read-only panel.")
    }'
    return
  fi

  local raw err valid=false message=""
  if [[ $TOKEN_KIND == oauth ]]; then
    # /user/tokens/verify only validates API tokens — an OAuth credential gets
    # "Invalid API Token" from it, which would be a lie. Ask instead whether
    # this credential can do the job: read zones.
    raw=$(api GET "/zones?per_page=1")
    err=$(api_error "$raw")
    if [[ -z $err ]]; then valid=true; message="active"; else message="$err"; fi
  else
    raw=$(api GET /user/tokens/verify)
    err=$(api_error "$raw")
    if [[ -n $err ]]; then
      message="$err"
    else
      message=$("$JQ" -r '.result.status // ""' <<<"$raw")
      [[ $message == active ]] && valid=true
    fi
  fi

  "$JQ" -n \
    --arg src "$TOKEN_SOURCE" \
    --arg kind "$TOKEN_KIND" \
    --arg expires "$TOKEN_EXPIRES" \
    --arg message "$message" \
    --argjson valid "$valid" \
    --argjson read_only "$(readonly_credential && echo true || echo false)" '{
      token: true,
      token_source: $src,
      token_kind: $kind,
      expires_at: $expires,
      read_only: $read_only,
      valid: $valid,
      message: $message
    } + (if $read_only then {
      hint: "Wrangler can only be granted zone:read, so the switches stay off. Add an API token to use them."
    } else {} end)'
}

# The zone list carries the account it belongs to, so tunnels and workers can
# be fetched without a separate Account:Read call.
cmd_zones() {
  require_token
  local cached raw err
  if cached=$(cache_read "zones.json" 300); then printf '%s\n' "$cached"; return; fi

  raw=$(api GET "/zones?per_page=50&order=name&direction=asc")
  err=$(api_error "$raw")
  if [[ -n $err ]]; then
    die "$err" "The token needs Zone → Zone → Read."
  fi
  "$JQ" '{
    zones: [ (.result // [])[] | {
      id:               .id,
      name:             .name,
      status:           (.status // ""),
      paused:           (.paused // false),
      plan:             (.plan.name // ""),
      development_mode: (.development_mode // 0),
      account_id:       (.account.id // ""),
      account_name:     (.account.name // "")
    } ]
  }' <<<"$raw" | cache_and_print "zones.json"
}

# One zone, everything the panel shows above the fold: what the zone is, the
# two switches, and 24 hours of traffic.
cmd_overview() {
  local zone="${1:-}"
  [[ -n $zone ]] || die "overview needs a zone id"
  require_token

  local cached
  if cached=$(cache_read "overview.$zone.json" 60); then printf '%s\n' "$cached"; return; fi

  local zraw zerr
  zraw=$(api GET "/zones/$zone")
  zerr=$(api_error "$zraw")
  [[ -n $zerr ]] && die "$zerr" "The token needs Zone → Zone → Read."

  # Security level lives behind Zone Settings, which a read-only token may not
  # carry. Missing it costs the Under Attack switch, not the whole panel.
  local sraw serr level
  sraw=$(api GET "/zones/$zone/settings/security_level")
  serr=$(api_error "$sraw")
  if [[ -n $serr ]]; then
    level=""
  else
    level=$("$JQ" -r '.result.value // ""' <<<"$sraw")
  fi

  local analytics analytics_error
  analytics=$(zone_analytics "$zone")
  analytics_error=$("$JQ" -r '.error // ""' <<<"$analytics")

  "$JQ" -n \
    --argjson zone "$zraw" \
    --argjson analytics "$analytics" \
    --arg level "$level" \
    --arg level_error "$serr" \
    --arg analytics_error "$analytics_error" '
    ($zone.result // {}) as $z | {
      zone: {
        id:               ($z.id // ""),
        name:             ($z.name // ""),
        status:           ($z.status // ""),
        paused:           ($z.paused // false),
        plan:             ($z.plan.name // ""),
        development_mode: ($z.development_mode // 0),
        account_id:       ($z.account.id // ""),
        account_name:     ($z.account.name // "")
      },
      security_level: $level,
      security_level_error: $level_error,
      under_attack: ($level == "under_attack"),
      analytics: ($analytics | del(.error)),
      analytics_error: $analytics_error
    }' | cache_and_print "overview.$zone.json"
}

# 24 hourly buckets from the GraphQL Analytics API. The REST dashboard endpoint
# it replaced is gone for new zones, and this is the one dataset every plan
# can read.
# Two windows, fetched as one 48-hour request and split on the midpoint, so a
# number can say whether it is normal. Cloudflare's own cards compare against
# the immediately preceding window of the same length, and the split is done by
# timestamp rather than by counting buckets: an hour with no traffic is absent
# from the response, so the newest 24 rows are not reliably the newest 24 hours.
zone_analytics() {
  local zone="$1" since mid till raw err
  since=$(date -u -d '-47 hours' +%Y-%m-%dT%H:00:00Z 2>/dev/null)
  mid=$(date -u -d '-23 hours'   +%Y-%m-%dT%H:00:00Z 2>/dev/null)
  till=$(date -u -d '+1 hour'    +%Y-%m-%dT%H:00:00Z 2>/dev/null)
  if [[ -z $since || -z $mid || -z $till ]]; then
    "$JQ" -n '{error: "could not compute a time window (needs GNU date)"}'
    return
  fi

  local vars
  vars=$("$JQ" -n --arg z "$zone" --arg s "$since" --arg u "$till" \
    '{zone: $z, since: $s, until: $u}')

  # Ask for everything, then give up one optional field at a time. Neither
  # `uniq { uniques }` nor `responseStatusMap` is readable on every plan, and
  # GraphQL fails the whole query over one it will not serve — so a zone that
  # cannot report visitors should still get its traffic, and one that cannot
  # report status codes should still get both.
  local attempt
  err="no analytics attempt ran"
  for attempt in "yes yes" "no yes" "yes no" "no no"; do
    # shellcheck disable=SC2086
    raw=$(gql "$(analytics_query $attempt)" "$vars")
    err=$(gql_error "$raw")
    [[ -z $err ]] && break
  done

  if [[ -n $err ]]; then
    "$JQ" -n --arg e "$err" '{
      error: $e, requests: 0, cached_requests: 0, bytes: 0, cached_bytes: 0,
      threats: 0, uniques: 0, cache_ratio: 0, series: [], uniques_known: false,
      server_errors: 0, client_errors: 0, statuses: {}, statuses_known: false,
      error_ratio: 0, comparison: "", previous: null,
      requests_delta: null, bytes_delta: null, cache_ratio_delta: null
    }'
    return
  fi

  "$JQ" --arg mid "$mid" '
    # One window, summed. Used twice: once for the last 24 hours and once for
    # the 24 before it, so the two are guaranteed to be measured the same way.
    def totals:
      ([.[] | .sum.requests // 0]         | add // 0) as $requests
      | ([.[] | .sum.cachedRequests // 0] | add // 0) as $cached
      # Every status the edge returned, summed across the window. A zone serving
      # nothing but 5xx has exactly the same request count as a healthy one, so
      # without this the panel cannot tell them apart.
      | (reduce (.[] | (.sum.responseStatusMap // [])[]) as $s
          ({}; .[$s.edgeResponseStatus | tostring] += ($s.requests // 0))) as $statuses
      | {
          requests:        $requests,
          cached_requests: $cached,
          bytes:           ([.[] | .sum.bytes // 0]       | add // 0),
          cached_bytes:    ([.[] | .sum.cachedBytes // 0] | add // 0),
          threats:         ([.[] | .sum.threats // 0]     | add // 0),
          uniques:         ([.[] | .uniq.uniques // 0]    | add // 0),
          uniques_known:   ([.[] | .uniq.uniques // null] | map(select(. != null)) | length) > 0,
          cache_ratio:     (if $requests > 0 then ($cached / $requests) else 0 end),
          # 5xx is the zone failing. 4xx is often the zone working — a block or
          # a 404 — so the two are never added together.
          server_errors:   ([$statuses | to_entries[] | select(.key | startswith("5")) | .value] | add // 0),
          client_errors:   ([$statuses | to_entries[] | select(.key | startswith("4")) | .value] | add // 0),
          statuses:        $statuses,
          statuses_known:  ($statuses | length > 0)
        };

    # Relative change, which is what Cloudflare reports — including for the
    # cache ratio, where the card reads as a percentage of the old percentage
    # and not as a difference in points. A zero baseline has no relative change
    # to report, so it yields null and the panel shows nothing rather than
    # inventing an arrow.
    def rel($now; $before): if $before == 0 then null else (($now - $before) / $before) end;

    ((.data.viewer.zones // [])[0].httpRequests1hGroups // []) as $all
    | ($all | map(select((.dimensions.datetime // "") >= $mid))) as $window
    | ($all | map(select((.dimensions.datetime // "") <  $mid))) as $before
    | ($window | totals) as $now
    | ($before | totals) as $prev
    | ($before | length > 0) as $comparable
    | $now + {
        error_ratio: (if $now.requests > 0
                      then ($now.server_errors / $now.requests) else 0 end),
        # Named so the panel can label the arrows without hardcoding a period
        # that the range selector will later change.
        comparison: (if $comparable then "previous 24 hours" else "" end),
        previous: (if $comparable then {
          requests:    $prev.requests,
          bytes:       $prev.bytes,
          cache_ratio: $prev.cache_ratio
        } else null end),
        requests_delta:    (if $comparable then rel($now.requests; $prev.requests) else null end),
        bytes_delta:       (if $comparable then rel($now.bytes; $prev.bytes) else null end),
        cache_ratio_delta: (if $comparable then rel($now.cache_ratio; $prev.cache_ratio) else null end),
        # The graph stays 24 hours wide. The earlier window is a baseline, not
        # something to draw.
        series: [ $window[] | {
          t:        (.dimensions.datetime // ""),
          requests: (.sum.requests // 0),
          cached:   (.sum.cachedRequests // 0),
          threats:  (.sum.threats // 0),
          bytes:    (.sum.bytes // 0)
        } ]
      }' <<<"$raw"
}

# Two optional blocks, because plan availability differs per field and GraphQL
# fails the whole query over one it will not serve.
analytics_query() {
  local uniq="" status=""
  [[ ${1:-} == yes ]] && uniq="uniq { uniques }"
  [[ ${2:-} == yes ]] && status="responseStatusMap { edgeResponseStatus requests }"
  cat <<QUERY
query (\$zone: String!, \$since: Time!, \$until: Time!) {
  viewer {
    zones(filter: {zoneTag: \$zone}) {
      httpRequests1hGroups(
        limit: 48
        orderBy: [datetime_ASC]
        filter: {datetime_geq: \$since, datetime_lt: \$until}
      ) {
        dimensions { datetime }
        sum { requests bytes cachedRequests cachedBytes threats $status }
        $uniq
      }
    }
  }
}
QUERY
}

cmd_tunnels() {
  local account="${1:-}"
  [[ -n $account ]] || die "tunnels needs an account id"
  require_token

  local cached raw err
  if cached=$(cache_read "tunnels.$account.json" 60); then printf '%s\n' "$cached"; return; fi

  raw=$(api GET "/accounts/$account/cfd_tunnel?is_deleted=false&per_page=50")
  err=$(api_error "$raw")
  if [[ -n $err ]]; then
    "$JQ" -n --arg e "$err" '{tunnels: [], error: $e, hint: "The token needs Account → Cloudflare Tunnel → Read."}'
    return
  fi
  # status is one of inactive / degraded / healthy / down.
  "$JQ" '{
    tunnels: [ (.result // [])[] | {
      id:          .id,
      name:        (.name // ""),
      status:      (.status // "inactive"),
      connections: ((.connections // []) | length),
      created_at:  (.created_at // "")
    } ]
  }' <<<"$raw" | cache_and_print "tunnels.$account.json"
}

cmd_workers() {
  local account="${1:-}"
  [[ -n $account ]] || die "workers needs an account id"
  require_token

  local cached raw err
  if cached=$(cache_read "workers.$account.json" 300); then printf '%s\n' "$cached"; return; fi

  raw=$(api GET "/accounts/$account/workers/scripts?per_page=50")
  err=$(api_error "$raw")
  if [[ -n $err ]]; then
    "$JQ" -n --arg e "$err" '{workers: [], error: $e, hint: "The token needs Account → Workers Scripts → Read."}'
    return
  fi

  # A deploy date says when you last touched a Worker. Invocations say whether
  # anyone is using it — which is the question you would open the dashboard to
  # answer, and the one thing a list of names cannot tell you.
  local metrics
  metrics=$(worker_metrics "$account")

  "$JQ" --argjson metrics "$metrics" '{
    workers: [ (.result // [])[] | (.id // "") as $name | {
      name:        $name,
      modified_on: (.modified_on // ""),
      placement:   (.placement_mode // "")
    } + (($metrics.scripts // {})[$name] // {}) ]
      | sort_by(.requests // -1, .modified_on) | reverse,
    metrics_error: ($metrics.error // "")
  }' <<<"$raw" | cache_and_print "workers.$account.json"
}

# Per-script invocation totals for the last 24 hours.
#
# Rows arrive split by status — success, clientDisconnected, scriptThrewException
# and so on — so requests and errors are summed across them. CPU time cannot be:
# a quantile is not an average, and averaging two p50s produces a number that
# describes nothing. The p50 reported is the one from the busiest status for that
# script, which is the population the figure actually came from.
worker_metrics() {
  local account="$1" since till raw err
  since=$(date -u -d '-24 hours' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  till=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  if [[ -z $since || -z $till ]]; then
    "$JQ" -n '{scripts: {}, error: "could not compute a time window"}'
    return
  fi

  local query vars
  query='query ($account: String!, $since: Time!, $until: Time!) {
  viewer {
    accounts(filter: {accountTag: $account}) {
      workersInvocationsAdaptive(
        limit: 200
        filter: {datetime_geq: $since, datetime_lt: $until}
      ) {
        dimensions { scriptName status }
        sum { requests errors subrequests }
        quantiles { cpuTimeP50 }
      }
    }
  }
}'
  vars=$("$JQ" -n --arg a "$account" --arg s "$since" --arg u "$till" \
    '{account: $a, since: $s, until: $u}')

  raw=$(gql "$query" "$vars")
  err=$(gql_error "$raw")
  if [[ -n $err ]]; then
    # The list of Workers is still worth showing without their traffic.
    "$JQ" -n --arg e "$err" '{scripts: {}, error: $e}'
    return
  fi

  "$JQ" '
    ((.data.viewer.accounts // [])[0].workersInvocationsAdaptive // []) as $rows
    | {
        scripts: (
          reduce $rows[] as $r ({};
            ($r.dimensions.scriptName // "") as $name
            | ($r.sum.requests // 0) as $requests
            | .[$name] = {
                requests:    ((.[$name].requests // 0) + $requests),
                errors:      ((.[$name].errors // 0) + ($r.sum.errors // 0)),
                subrequests: ((.[$name].subrequests // 0) + ($r.sum.subrequests // 0)),
                # Keep the p50 belonging to the busiest status seen so far.
                cpu_p50_us:  (if $requests >= (.[$name].busiest // -1)
                              then ($r.quantiles.cpuTimeP50 // 0)
                              else (.[$name].cpu_p50_us // 0) end),
                busiest:     (if $requests >= (.[$name].busiest // -1)
                              then $requests else (.[$name].busiest // 0) end)
              })
          | with_entries(.value |= del(.busiest))
        ),
        error: ""
      }' <<<"$raw"
}

# One Worker, in detail: where its invocations went, how long they took, and
# what the last 24 hours looked like hour by hour. Fetched on demand — the list
# view only needs totals, and this asks for a row per hour per status.
cmd_worker() {
  local account="${1:-}" script="${2:-}"
  [[ -n $account ]] || die "worker needs an account id"
  [[ -n $script ]] || die "worker needs a script name"
  require_token

  local cached
  if cached=$(cache_read "worker.$account.$script.json" 60); then printf '%s\n' "$cached"; return; fi

  local since till
  since=$(date -u -d '-24 hours' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  till=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
  if [[ -z $since || -z $till ]]; then
    die "could not compute a time window"
  fi

  local query vars raw err
  query='query ($account: String!, $script: String!, $since: Time!, $until: Time!) {
  viewer {
    accounts(filter: {accountTag: $account}) {
      workersInvocationsAdaptive(
        limit: 1000
        orderBy: [datetimeHour_ASC]
        filter: {datetime_geq: $since, datetime_lt: $until, scriptName: $script}
      ) {
        dimensions { datetimeHour status }
        sum { requests errors subrequests }
        quantiles { cpuTimeP50 cpuTimeP99 }
      }
    }
  }
}'
  vars=$("$JQ" -n --arg a "$account" --arg s "$script" --arg since "$since" --arg u "$till" \
    '{account: $a, script: $s, since: $since, until: $u}')

  raw=$(gql "$query" "$vars")
  err=$(gql_error "$raw")
  if [[ -n $err ]]; then
    "$JQ" -n --arg name "$script" --arg e "$err" \
      '{worker: {name: $name}, statuses: [], series: [], error: $e}'
    return
  fi

  # Quantiles are never summed or averaged: for each status the figure kept is
  # the one from that status'"'"'s busiest hour, which is the population it
  # actually describes. Requests and errors do add up.
  "$JQ" --arg name "$script" '
    ((.data.viewer.accounts // [])[0].workersInvocationsAdaptive // []) as $rows
    | (reduce $rows[] as $r ({};
        ($r.dimensions.status // "unknown") as $status
        | ($r.sum.requests // 0) as $requests
        | .[$status] = {
            status:     $status,
            requests:   ((.[$status].requests // 0) + $requests),
            errors:     ((.[$status].errors // 0) + ($r.sum.errors // 0)),
            cpu_p50_us: (if $requests >= (.[$status].busiest // -1)
                         then ($r.quantiles.cpuTimeP50 // 0) else (.[$status].cpu_p50_us // 0) end),
            cpu_p99_us: (if $requests >= (.[$status].busiest // -1)
                         then ($r.quantiles.cpuTimeP99 // 0) else (.[$status].cpu_p99_us // 0) end),
            busiest:    (if $requests >= (.[$status].busiest // -1)
                         then $requests else (.[$status].busiest // 0) end)
          })) as $by_status
    | (reduce $rows[] as $r ({};
        ($r.dimensions.datetimeHour // "") as $hour
        | .[$hour] = {
            t:        $hour,
            requests: ((.[$hour].requests // 0) + ($r.sum.requests // 0)),
            errors:   ((.[$hour].errors // 0) + ($r.sum.errors // 0))
          })) as $by_hour
    | ([$by_status[] | .requests] | add // 0) as $requests
    | ([$by_status[] | .errors] | add // 0) as $errors
    | ([$by_status | to_entries[] | select(.key == "success")][0].value) as $success
    | {
        worker: {
          name:        $name,
          requests:    $requests,
          errors:      $errors,
          subrequests: ([$rows[] | .sum.subrequests // 0] | add // 0),
          # The headline pair belongs to the busiest status, which is the one
          # the overwhelming majority of invocations took.
          cpu_p50_us:  ([$by_status[]] | sort_by(.requests) | last | .cpu_p50_us // 0),
          cpu_p99_us:  ([$by_status[]] | sort_by(.requests) | last | .cpu_p99_us // 0),
          success_ratio: (if $requests > 0
                          then (($success.requests // 0) / $requests) else 0 end),
          hours: ($by_hour | length)
        },
        statuses: ([$by_status[] | del(.busiest)] | sort_by(.requests) | reverse),
        series:   ([$by_hour[]] | sort_by(.t)),
        error: ""
      }' <<<"$raw" | cache_and_print "worker.$account.$script.json"
}

# ---------------------------------------------------------------- setting up

# What routes to a credential exist on this machine. The panel's setup screen
# is built from this rather than from guesses, so it never offers a wrangler
# button on a box with no wrangler and no node to run one.
cmd_setup() {
  local wrangler_cli npx_cli wrangler_cmd="" session="none" expires="" env_var="" file_present=false keyring=false
  wrangler_cli=$(resolve wrangler || true)
  npx_cli=$(resolve npx || true)
  if [[ -n $wrangler_cli ]]; then
    wrangler_cmd="wrangler login"
  elif [[ -n $npx_cli ]]; then
    wrangler_cmd="npx --yes wrangler@latest login"
  fi

  local file token expiry_epoch now
  for file in "${WRANGLER_CONFIGS[@]}"; do
    [[ -r $file ]] || continue
    token=$(toml_value "$file" oauth_token)
    [[ -n $token ]] || continue
    expires=$(toml_value "$file" expiration_time)
    session="active"
    if [[ -n $expires ]]; then
      expiry_epoch=$(date -u -d "$expires" +%s 2>/dev/null) || expiry_epoch=""
      now=$(date -u +%s)
      [[ -n $expiry_epoch ]] && (( expiry_epoch <= now )) && session="expired"
    fi
    break
  done

  # Named, never printed: an environment token silently outranks a saved file,
  # and someone wondering why their pasted token did nothing deserves to know.
  if   [[ -n ${CLOUDFLARE_API_TOKEN:-} ]]; then env_var="CLOUDFLARE_API_TOKEN"
  elif [[ -n ${CF_API_TOKEN:-} ]];        then env_var="CF_API_TOKEN"
  fi
  [[ -r $TOKEN_FILE ]] && file_present=true
  resolve secret-tool >/dev/null 2>&1 && keyring=true

  "$JQ" -n \
    --arg wrangler_cmd "$wrangler_cmd" \
    --arg session "$session" \
    --arg expires "$expires" \
    --arg env_var "$env_var" \
    --arg token_path "$(pretty_path "$TOKEN_FILE")" \
    --argjson file_present "$file_present" \
    --argjson keyring "$keyring" '{
      wrangler_command: $wrangler_cmd,
      wrangler_available: ($wrangler_cmd != ""),
      wrangler_session: $session,
      wrangler_expires_at: $expires,
      env_var: $env_var,
      token_file: $token_path,
      token_file_present: $file_present,
      keyring_available: $keyring,
      token_url: "https://dash.cloudflare.com/profile/api-tokens"
    }'
}

# The token arrives on stdin, never in argv, so it cannot be read out of the
# process list. It is checked before it is written: a saved token that does not
# work is worse than no token at all, because it outranks — and therefore
# hides — the wrangler fallback that was working a moment ago.
cmd_save_token() {
  local token
  IFS= read -r token || true
  token=$(printf '%s' "${token:-}" | tr -d '\r\n[:space:]')
  [[ -n $token ]] || die "no token given"

  TOKEN="$token"
  TOKEN_KIND="api"
  TOKEN_SOURCE="stdin"

  local raw err
  raw=$(api GET /user/tokens/verify)
  err=$(api_error "$raw")
  [[ -n $err ]] && die "$err" "Nothing was saved."

  # verify only proves the token exists and is active. This proves it can do
  # the one thing the panel cannot work without.
  raw=$(api GET "/zones?per_page=1")
  err=$(api_error "$raw")
  [[ -n $err ]] && die "$err" "The token is valid but cannot read zones — it needs Zone → Zone → Read. Nothing was saved."

  local dir; dir=$(dirname "$TOKEN_FILE")
  mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null
  ( umask 077; printf '%s\n' "$token" > "$TOKEN_FILE" ) || die "could not write $(pretty_path "$TOKEN_FILE")"
  chmod 600 "$TOKEN_FILE" 2>/dev/null

  # Anything cached was fetched by whatever credential came before this one.
  rm -rf "$CACHE_DIR" 2>/dev/null

  "$JQ" -n --arg path "$(pretty_path "$TOKEN_FILE")" \
           --arg env "${CLOUDFLARE_API_TOKEN:+CLOUDFLARE_API_TOKEN}" '
    {ok: true, saved_to: $path}
    + (if $env == "" then {} else
        {warning: ($env + " is set and takes precedence over the saved file.")}
       end)'
}

cmd_forget_token() {
  local had=false
  [[ -r $TOKEN_FILE ]] && had=true
  rm -f "$TOKEN_FILE" 2>/dev/null
  rm -rf "$CACHE_DIR" 2>/dev/null
  "$JQ" -n --argjson had "$had" --arg env "${CLOUDFLARE_API_TOKEN:+CLOUDFLARE_API_TOKEN}${CF_API_TOKEN:+CF_API_TOKEN}" '
    {ok: true, removed: $had}
    + (if $env == "" then {} else
        {warning: ($env + " is still set in the environment; this cannot unset it.")}
       end)'
}

# ------------------------------------------------------------------- writes

cmd_devmode() {
  local zone="${1:-}" value="${2:-}"
  [[ -n $zone ]] || die "devmode needs a zone id"
  [[ $value == on || $value == off ]] || die "devmode takes on or off"
  require_token
  require_write

  local raw err
  raw=$(api PATCH "/zones/$zone/settings/development_mode" "$("$JQ" -n --arg v "$value" '{value: $v}')")
  err=$(api_error "$raw")
  [[ -n $err ]] && die "$err" "The token needs Zone → Zone Settings → Edit."

  cache_drop "overview.$zone.json"
  cache_drop "zones.json"
  "$JQ" '{ok: true, value: (.result.value // ""), time_remaining: (.result.time_remaining // 0)}' <<<"$raw"
}

# Under Attack is a security_level value, not a switch of its own, so turning it
# off has to restore something. The level in force before it was raised is kept
# here; without that record "off" would silently rewrite the zone to whatever
# default this plugin picked.
cmd_attack() {
  local zone="${1:-}" value="${2:-}"
  [[ -n $zone ]] || die "attack needs a zone id"
  [[ $value == on || $value == off ]] || die "attack takes on or off"
  require_token
  require_write

  local previous_file="$STATE_DIR/security_level.$(cache_key "$zone")"
  local target=""

  if [[ $value == on ]]; then
    local craw cerr current
    craw=$(api GET "/zones/$zone/settings/security_level")
    cerr=$(api_error "$craw")
    [[ -n $cerr ]] && die "$cerr" "The token needs Zone → Zone Settings → Read."
    current=$("$JQ" -r '.result.value // ""' <<<"$craw")
    if [[ -n $current && $current != under_attack ]]; then
      mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$current" > "$previous_file"
    fi
    target="under_attack"
  else
    target="medium"
    if [[ -r $previous_file ]]; then
      local saved
      saved=$(tr -d '\r\n[:space:]' < "$previous_file")
      [[ -n $saved && $saved != under_attack ]] && target="$saved"
    fi
  fi

  local raw err
  raw=$(api PATCH "/zones/$zone/settings/security_level" "$("$JQ" -n --arg v "$target" '{value: $v}')")
  err=$(api_error "$raw")
  [[ -n $err ]] && die "$err" "The token needs Zone → Zone Settings → Edit."

  cache_drop "overview.$zone.json"
  "$JQ" --arg restored "$target" '{ok: true, value: (.result.value // $restored)}' <<<"$raw"
}

cmd_purge() {
  local zone="${1:-}"
  [[ -n $zone ]] || die "purge needs a zone id"
  require_token
  require_write

  local raw err
  raw=$(api POST "/zones/$zone/purge_cache" '{"purge_everything":true}')
  err=$(api_error "$raw")
  [[ -n $err ]] && die "$err" "The token needs Zone → Cache Purge → Purge."

  cache_drop "overview.$zone.json"
  "$JQ" -n '{ok: true, purged: "everything"}'
}

# ---------------------------------------------------------------- dispatch

case "${1:-status}" in
  status)   cmd_status ;;
  setup)    cmd_setup ;;
  save-token)   cmd_save_token ;;
  forget-token) cmd_forget_token ;;
  zones)    cmd_zones ;;
  overview) shift; cmd_overview "$@" ;;
  tunnels)  shift; cmd_tunnels "$@" ;;
  workers)  shift; cmd_workers "$@" ;;
  worker)   shift; cmd_worker "$@" ;;
  devmode)  shift; cmd_devmode "$@" ;;
  attack)   shift; cmd_attack "$@" ;;
  purge)    shift; cmd_purge "$@" ;;
  -h|--help|help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command: ${1:-}" "Run cloudflarechy --help" ;;
esac
